# Discord bot token for the instance you operate
DISCORD_TOKEN=

# Groq key used by the announcement cog
GROQ_API_KEY=

# Public display/configuration
SERVER_NAME=Your Server Name
BOT_NAME=Imperial Command System
GUILD_ID=
DASHBOARD_PUBLIC_URL=

# Optional logging
LOG_WEBHOOK_URL=

# Dashboard session and Discord OAuth login
DASHBOARD_SECRET_KEY=replace-with-a-long-random-value
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5000/callback
DASHBOARD_ALLOWED_USER_IDS=
SUPER_ADMIN_USER_IDS=

# Discord Administrator by default; use a narrower integer when possible
BOT_INVITE_PERMISSIONS=8
