.env
*.env
*.env.*
!.env.example
__pycache__/
*.pyc

# Python virtual environment - never commit this, everyone creates their own
venv/
.venv/
env/

# Live bot data - created at runtime, must never be overwritten by a git pull
*_data.json

# Per-machine role permission config - different role IDs on your test
# server vs your real server, must never sync between them
permissions_config.json
command_toggles.json
usage_data.json
server_config.json
bot_logs.json
maintenance.json

# Economy database - live data, per-machine, never synced via git
economy/economy.db
economy/economy.db-wal
economy/economy.db-shm
